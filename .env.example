# FlowBoard server configuration.
# Copy this file to server/.env:   cp .env.example server/.env
# The client needs no .env in development (Vite proxies /api to the server).

NODE_ENV=development
PORT=5000

# Local MongoDB (Windows service, Homebrew, or `docker run -d -p 27017:27017 mongo:7`) or a MongoDB Atlas URI.
MONGO_URI=mongodb://127.0.0.1:27017/flowboard

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Origin of the React app (used for CORS and for links in password-reset emails).
CLIENT_URL=http://localhost:5173

# bcrypt cost factor (12 is a good default; tests use 4 for speed).
BCRYPT_ROUNDS=12

# Password-reset links expire after this many minutes and work only once.
RESET_TOKEN_TTL_MINUTES=15

# Development only: write reset emails to server/dev-mailbox/ and expose them at GET /api/dev/mailbox
# so the reset flow works without an email provider. Ignored (route never mounted) when NODE_ENV=production.
DEV_MAILBOX=true

# Seed script only: password for the local demo account. Never use it for a real account.
SEED_DEMO_PASSWORD=Demo@12345
